# Local MySQL database. Set the production database URL in Render's environment.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/intellibusiness

# JWT Authentication Secret & Config
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend deployment origin used by email links and OAuth callback redirects.
FRONTEND_BASE_URL=http://127.0.0.1:3000

# Explicit local and production frontend origins; do not use '*'.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://intelli-business12.vercel.app

# Google OpenID Connect. Use the local callback for development; set the production
# callback below in Render and register both callback URLs in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# Production: https://intellibusiness-db.onrender.com/api/auth/google/callback
# Production FRONTEND_BASE_URL: https://intelli-business12.vercel.app

# Gemini and embedding API keys
GEMINI_API_KEY=
AI_API_KEY=
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Application email is sent through Gmail API as intellibusiness12@gmail.com.
# Obtain GMAIL_REFRESH_TOKEN once with `python backend/oauth_setup.py`.
GMAIL_REFRESH_TOKEN=
